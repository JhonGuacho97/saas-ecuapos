APP_NAME="EcuaPos"
APP_ENV=local
# Vacío a propósito -- corré `php artisan key:generate` en cada entorno
# nuevo. Antes este archivo traía una clave real y funcional; cualquier
# instalación que copiara .env.example a .env sin regenerarla quedaba con
# la MISMA clave que cualquier otra instalación hecha así, incluyendo la
# que protege el cifrado de la contraseña del certificado de firma SRI
# guardada en la tabla settings.
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

SAAS_SELF_REGISTRATION_ENABLED=true

# Dominios reales de producción, separados por comas (ej.
# "https://pos.tuempresa.com"). Si se deja vacío/sin definir, CORS
# permite cualquier origen -- útil en desarrollo local, no recomendado en
# producción.
CORS_ALLOWED_ORIGINS=*

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE="laravel"
DB_USERNAME="root"
DB_PASSWORD="root"

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# 'sync' ejecuta los Jobs de facturación electrónica (EmitirFacturaJob,
# AutorizarFacturaJob) en el mismo request HTTP, sin reintentos reales ni
# backoff -- una respuesta lenta del SRI puede colgar el proceso que
# atiende al cajero. Antes de habilitar facturación electrónica en
# producción, cambiar a 'database' + correr `php artisan queue:work` (cron
# o Supervisor según lo que permita el hosting).
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

# 1 = Pruebas (celcer.sri.gob.ec, comprobantes NO válidos legalmente),
# 2 = Producción (cel.sri.gob.ec, comprobantes reales). Este valor es solo
# el fallback si no hay nada guardado en Configuración > SRI de la app
# (tabla settings, clave 'sri_ambiente') -- una vez configurado ahí,
# ese valor manda. Se deja en 1 (pruebas) a propósito: es más seguro que
# una instalación nueva sin configurar queme numeración real del SRI por
# accidente, a que calladamente crea estar facturando en producción sin
# estarlo. Confirmar explícitamente en la UI antes de emitir el primer
# comprobante real.
SRI_AMBIENTE=1

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME="username"
MAIL_PASSWORD="password"
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="from@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

MEDIA_DISK=public
SANCTUM_TTL=120

UPGRADE_MODE=false
